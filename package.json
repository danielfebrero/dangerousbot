{
  "name": "dangerousbot",
  "version": "0.1.0",
  "description": "DangerousBot - Programme IA autonome et évolutif",
  "main": "dist/dangerousbot.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/main.ts",
    "build": "node esbuild.config.js",
    "build:server": "node esbuild.config.js --server-only",
    "build:client": "node esbuild.config.js --client-only",
    "start": "NODE_ENV=production node dist/dangerousbot.js",
    "start:daemon": "./start.sh",
    "setup": "tsx src/cli/setup.ts",
    "setup:keys": "tsx src/cli/setup-keys.ts",
    "setup:keys:status": "tsx src/cli/setup-keys.ts --status",
    "searxng": "./searxng.sh",
    "searxng:start": "./searxng.sh start",
    "searxng:stop": "./searxng.sh stop",
    "searxng:restart": "./searxng.sh restart",
    "searxng:status": "./searxng.sh status",
    "searxng:logs": "./searxng.sh logs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "node-telegram-bot-api": "^0.67.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0"
  }
}
